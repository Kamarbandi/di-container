{
    "name": "azad/container",
    "description": "A professional PSR-11 dependency injection container with autowiring, attribute-based injection, service providers, tags and delegate lookup.",
    "keywords": ["psr-11", "container", "di", "dependency-injection", "autowiring", "psr-container"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Azad Kamarbandi"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Azad\\Container\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azad\\Container\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": [
            "@composer validate",
            "phpcs",
            "phpstan analyse",
            "phpunit --do-not-cache-result --testdox"
        ],
        "csfix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
